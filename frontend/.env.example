# Copy to .env.local for local development. Non-secret values only:
# never put AWS keys or passwords in frontend env files (they end up in the bundle).

# Local dev server (backend/local/dev_server.py):
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_ENV=local

# Deployed API (scripts/deploy-frontend.sh writes .env.production.local for you):
# VITE_API_BASE_URL=https://xxxx.execute-api.us-east-1.amazonaws.com
# VITE_APP_ENV=aws
